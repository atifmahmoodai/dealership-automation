# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. Outside Docker set it yourself:
# DATABASE_URL=postgres://auto:PASSWORD@localhost:5432/auto

# --- Web ---
# The address staff open (https in production). Used for the CSRF origin check.
PUBLIC_URL=http://localhost:8080
# Behind nginx / Caddy / a cloud load balancer that terminates https:
TRUST_PROXY=false
# Secure cookies need https. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=production
APP_PORT=8080

# Dealership time zone (IANA name): quiet hours for automated messages follow it.
TIMEZONE=Europe/London

# --- Sessions ---
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=300

# --- Worker ---
# "inline" runs the channel sync and message sending inside the web process. With several web
# processes, set WORKER=off on them and run one "node dist/cli/worker.js".
WORKER=inline
WORKER_INTERVAL_MS=5000
